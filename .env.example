# Copy to .env and fill in. Never commit .env.

# Optional: enables the live AI founder (Claude). Without it, a built-in
# offline founder answers from the pitch facts.
ANTHROPIC_API_KEY=

# Database for game sessions + classrooms. Default: local SQLite file.
# Production: Supabase → Project Settings → Database → Connection string (URI, "Session pooler").
# DATABASE_URL=postgresql://postgres.uulpajrparfidqyntdop:<DB_PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Game tuning
STARTING_BANKROLL=1000000
ROUNDS_PER_GAME=5
MAX_QUESTIONS_PER_ROUND=3

# Supabase (accounts, saved runs, leaderboards). URL + publishable key are public.
SUPABASE_URL=https://uulpajrparfidqyntdop.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_q7KqXEH7Ffl5U3J1mDVB3g_Lerv-UuR
# Server-only secret key (Dashboard → Project Settings → API Keys → Secret keys).
# Needed to save runs and show leaderboards. NEVER commit or expose it.
SUPABASE_SECRET_KEY=
# "local" reads pitches/ folder; "supabase" reads the pitches table (run scripts/sync_pitches.py first)
PITCH_SOURCE=local

# Optional: where the frontend finds the API in production (dev uses the Vite proxy)
# VITE_API_URL=https://api.example.com
