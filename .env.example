# Copy to .env and fill in. Never commit .env.

# Optional: enables the live AI founder (Claude). Without it, a built-in
# offline founder answers from the pitch facts.
ANTHROPIC_API_KEY=

# Game tuning
STARTING_BANKROLL=10000000
ROUNDS_PER_GAME=5
MAX_QUESTIONS_PER_ROUND=3

# Frontend -> backend URL (used by Vite at build time)
VITE_API_URL=http://localhost:8000
